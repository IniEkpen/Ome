# Copy to .env and fill in locally. Never commit real values.
LLAMA_API_KEY=
DATABASE_URL=
PORT=3000

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
AUTH_TOKEN_SECRET=

# Stripe (server side only). Use test keys (sk_test_...) until launch.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Continue with Google: comma separated OAuth client ids from Google Cloud
# Console (the iOS client id, plus the Web client id for Chrome/Android).
GOOGLE_CLIENT_IDS=

# Sign in with Apple: the app's bundle id, app.yuwo (comma separated if you add more).
APPLE_CLIENT_IDS=
# Needed to revoke Apple sign-in when an account is deleted (App Review checks).
# developer.apple.com > Certificates, IDs & Profiles > Keys > a key with Sign in with Apple.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The .p8 file's contents on one line, with 
 for each line break.
APPLE_PRIVATE_KEY=

# Optional: comma separated browser origins allowed to call the API.
CORS_ORIGINS=
