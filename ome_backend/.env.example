# Copy to .env and fill in locally. Never commit real values.
LLAMA_API_KEY=
DATABASE_URL=
PORT=3000

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
AUTH_TOKEN_SECRET=

# Stripe. Use test keys until launch. Payments are USD only. Setup steps: ome_backend/STRIPE.md
# Secret key (sk_test_...): server only, never put it in the app.
STRIPE_SECRET_KEY=
# Publishable key (pk_test_...): the app loads it from GET /payments/config.
STRIPE_PUBLISHABLE_KEY=
# whsec_... for POST /payments/webhook. Comma separate the platform and Connect endpoint secrets.
STRIPE_WEBHOOK_SECRET=
# whsec_... for the thin-event destination POST /payments/webhook/accounts (host account updates).
STRIPE_ACCOUNTS_WEBHOOK_SECRET=
# true = when a dispute is lost, also pull the money back from the host's Stripe balance.
STRIPE_RECOVER_LOST_DISPUTES_FROM_HOSTS=false

# Optional: comma separated browser origins allowed to call the API.
CORS_ORIGINS=
